---
import Button from '../ds/Button.astro';
import Logo from '../Logo.astro';
import Wordmark from '../Wordmark.astro';
import { COLAB_URL, LINKS } from '../../config';

// Name, marker (* equal contribution, † equal advising) and affiliation numbers, as on the paper;
// null forces a line break: six names on the first row, three on the second.
const AUTHORS: ([name: string, marker: string, affiliations: string] | null)[] = [
  ['Igor Shilov', '*', '1'],
  ['Xiaoxue Yang', '*', '1'],
  ['Alexander Panfilov', '*', '2,3,4'],
  ['Evgenii Kortukov', '', '5'],
  ['Matthieu Meeus', '', '1'],
  ['Peter Romov', '', '1'],
  null,
  ['Wojciech Samek', '', '5'],
  ['Jonas Geiping', '†', '2,3,4'],
  ['Yves-Alexandre de Montjoye', '†', '1'],
];
const AFFILIATIONS = [
  'Imperial College London',
  'Tübingen AI Center',
  'ELLIS Institute Tübingen',
  'Max Planck Institute for Intelligent Systems',
  'Fraunhofer HHI',
];
const NOTES: [marker: string, text: string][] = [
  ['*', 'Equal contribution'],
  ['†', 'Equal advising'],
];
---

<header id="c-top" class="hero">
  <h1 class="display hero-title wordmark"><Wordmark /></h1>
  <p class="hero-subtitle">Learned attention gates improve prompt injection robustness</p>
  <div class="hero-authors">
    {
      AUTHORS.map((a) =>
        a ? (
          <span>{a[0]}<sup>{a[1] ? `${a[1]} ${a[2]}` : a[2]}</sup></span>
        ) : (
          <span class="line-break" aria-hidden="true" />
        ),
      )
    }
  </div>
  <div class="hero-affiliations">
    {AFFILIATIONS.map((name, i) => <span><sup>{i + 1}</sup>{name}</span>)}
  </div>
  <div class="hero-affiliations hero-notes">
    {NOTES.map(([marker, text]) => <span><sup>{marker}</sup>{text}</span>)}
  </div>
  <div class="hero-actions">
    <Button variant="secondary" href={LINKS.paper} external><Logo name="arxiv" size={17} />Paper</Button>
    <Button variant="secondary" href={LINKS.code} external><Logo name="github" size={17} />Code</Button>
    <Button variant="secondary" href={LINKS.models} external><Logo name="hugging-face" size={17} />Models</Button>
    <Button variant="secondary" href={LINKS.space} external><Logo name="hugging-face" size={17} />Live demo</Button>
    <Button variant="secondary" href={COLAB_URL} external><Logo name="colab" size={17} />Tutorial</Button>
  </div>
</header>
