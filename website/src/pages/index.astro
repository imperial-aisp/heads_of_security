---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Method from '../components/sections/Method.astro';
import Results from '../components/sections/Results.astro';
import TryIt from '../components/sections/TryIt.astro';
import Cite from '../components/sections/Cite.astro';

const SECTIONS = [
  { href: '#c-method', label: 'Method' },
  { href: '#c-results', label: 'Results' },
  { href: '#c-try', label: 'Try it' },
  { href: '#c-cite', label: 'Cite' },
];
---

<Base
  title="Heads of Security: Learned Attention Gates Improve Prompt Injection Robustness"
  description="Heads of Security (HoS) is a prompt injection defense that enforces instruction–data separation with a small set of learned per-head attention gates."
>
  <Nav sections={SECTIONS} />
  <main class="page">
    <Hero />
    <Method />
    <Results />
    <TryIt />
    <Cite />
  </main>
</Base>
